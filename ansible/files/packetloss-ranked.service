[Unit]
Description=PacketLoss — Auto-criar inscrição rankeada
After=network.target packetloss.service

[Service]
Type=oneshot
User=nginx
WorkingDirectory=/var/www/packetloss
EnvironmentFile=/var/www/packetloss/.env
ExecStart=/bin/bash /var/www/packetloss/scripts/ranked-auto.sh
StandardOutput=journal
StandardError=journal
